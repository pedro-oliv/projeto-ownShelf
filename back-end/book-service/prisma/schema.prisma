generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LibraryAccessType {
  DIGITAL
  PHYSICAL
  BOTH
}

enum ReadingStatus {
  NOT_STARTED
  READING
  FINISHED
  PAUSED
}

model Book {
  id            String   @id @default(uuid())
  title         String
  author        String
  synopsis      String
  categories    String[]
  publishYear   String
  physicalStock Int
  coverUrl      String
  pdfUrl        String?
  totalPages    Int?

  libraries     Library[]

  physicalPrice Decimal? @db.Decimal(10, 2)
  digitalPrice  Decimal? @db.Decimal(10, 2)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Library {
  id             String          @id @default(uuid())
  userId         String
  bookId         String
  transactionId  String?

  favorite       Boolean         @default(false)

  accessType     LibraryAccessType

  readingStatus  ReadingStatus   @default(NOT_STARTED)

  lastPage       Int             @default(1)

  book           Book            @relation(fields: [bookId], references: [id])

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}
